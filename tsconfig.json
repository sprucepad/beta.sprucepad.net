{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@content/*": ["./content/*"],

      // Lucide doesn't export its generic Icon component outside of root,
      // which is really slow for Astro and Svelte. So I'm doing it here.
      "@lucide/astro-icon": ["./node_modules/@lucide/astro/src/Icon.astro"],
      "@lucide/svelte-icon": ["./node_modules/@lucide/svelte/dist/Icon.svelte"]
    }
  },
  "include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts"],
  "exclude": ["dist"]
}
