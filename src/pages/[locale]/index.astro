---
import Article from "@/components/Article.astro";
import Layout from "@/layouts/Layout.astro";
import { localizeGetStaticPaths } from "@/lib/i18n";
import { m } from "@/paraglide/messages";
import { getEntry } from "astro:content";
import { render } from "astro:content";

export const getStaticPaths = localizeGetStaticPaths();
const { locale } = Astro.params;

const { Content } = await render(
  await getEntry("articles", `${locale}/about`)!,
);
---

<Layout title={m.index_title()} desc={m.index_desc()}>
  <section class="grid place-content-center min-h-[calc(100svh-16rem)]">
    <h1 class="font-pixel text-4xl font-black">{m.index_message()}</h1>
  </section>

  <section>
    <Article>
      <Content />
    </Article>
  </section>
</Layout>
