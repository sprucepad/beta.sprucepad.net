---
import Headings from "@/components/Headings.astro";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => {
    const [locale, ...idSegments] = post.id.split("/");
    return {
      params: { locale, postId: idSegments.join("/") },
      props: { post },
    };
  });
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { postId } = Astro.params;

const { Content, headings } = await render(post);
---

<ArticleLayout {post} {postId} class="max-w-[calc(65ch+10rem)] mx-auto">
  <Headings {headings} />
  <Content />

  <Headings {headings} slot="sidebar" fixed />
</ArticleLayout>
