---
import Layout from "@/layouts/Layout.astro";
import Cards from "@/components/Cards.svelte";
import { getCards } from "@/lib/collections";
import { getRelativeLocaleUrl } from "astro:i18n";

const locale = Astro.currentLocale!;

const posts = await getCards(locale, "posts");
---

<Layout
  title="blog | sprucepad"
  desc="meu blog, com devlogs dos meus projetos, escritas sobre arte ou qualquer coisa que quero escrever sobre!"
  class="mx-auto max-w-prose"
>
  <Cards
    client:load
    cards={posts}
    href={getRelativeLocaleUrl(locale, "/blog")}
    placeholder="Pesquisar nos posts do blog"
    empty="Nenhum post ainda!"
  />
</Layout>
