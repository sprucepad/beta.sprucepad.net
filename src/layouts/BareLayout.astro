---
import "@/styles/global.css";
import favicon from "@content/assets/favicon.png";
import defaultCover from "@content/assets/default-cover.png";

import ClientRouter from "astro/components/ClientRouter.astro";
import Font from "astro/components/Font.astro";
import type { HTMLAttributes } from "astro/types";
import { getImage } from "astro:assets";
import Themes from "@/components/Themes.astro";
import type { ThemeDetail } from "@/lib/types";
import { getLocale } from "@/paraglide/runtime";

export interface LayoutProps {
  title: string;
  desc: string;
  cover?: ImageMetadata;
  theme?: ThemeDetail;
}

interface Props
  extends LayoutProps, Omit<HTMLAttributes<"body">, keyof LayoutProps> {}

const {
  title,
  desc,
  cover: unoptimizedCover = defaultCover,
  theme,
  ...rest
} = Astro.props;
const optimizedCover = await getImage({
  src: unoptimizedCover,
  width: 1280,
  height: 628,
  fit: "contain",
});
const coverURL = new URL(optimizedCover.src, Astro.site);

function createThemeStyles(colors: ThemeDetail["colors"]) {
  if (!colors) return;

  return {
    "--background": colors.background,
    "--foreground": colors.foreground,
    "--accent": colors.accent,
    "--accent-foreground": colors.accentForeground,
    "--secondary": colors.secondary,
    "--secondary-foreground": colors.secondaryForeground,
    "--border": colors.border,
  };
}

const style = createThemeStyles(theme?.colors);
---

<html
  lang={getLocale()}
  data-theme={theme ? `${theme?.scheme}:${theme?.id}` : "light"}
  data-mode="off"
  {style}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />
    <Font cssVariable="--font-dm-sans" />
    <Font cssVariable="--font-jb-mono" />
    <Font cssVariable="--font-peaberry" />
    <Themes />

    {/* primary */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={desc} />

    {/* open graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={coverURL} />

    {/* twitter (x) */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.site} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={desc} />
    <meta property="twitter:image" content={coverURL} />
  </head>
  <body {...rest}>
    <slot />
  </body>
</html>
