---
import type { HTMLAttributes } from "astro/types";
import BaseLayout, { type LayoutProps } from "./BareLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props
  extends LayoutProps, Omit<HTMLAttributes<"main">, keyof LayoutProps> {}

const { title, desc, image, theme, ...rest } = Astro.props;
---

<BaseLayout {title} {desc} {image} {theme}>
  <Header />
  <main transition:name="main" transition:animate="slide" {...rest}>
    <slot />
  </main>
  <Footer />
</BaseLayout>
