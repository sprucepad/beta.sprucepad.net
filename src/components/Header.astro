---
import pfp from "@content/assets/pfp.png";
import BMCIcon from "@content/assets/bmc.svg";
import GitHubIcon from "@content/assets/github.svg";
import YouTubeIcon from "@content/assets/youtube.svg";
import RedditIcon from "@content/assets/reddit.svg";
import BskyIcon from "@content/assets/bsky.svg";
import ItchIoIcon from "@content/assets/itchio.svg";
import HeartPlusIcon from "@lucide/astro/icons/heart-plus";
import MenuIcon from "@lucide/astro/icons/menu";
import XIcon from "@lucide/astro/icons/x";
import InfoIcon from "@lucide/astro/icons/info";
import MailQuestionMarkIcon from "@lucide/astro/icons/mail-question-mark";
import RSSIcon from "@lucide/astro/icons/rss";
import BrushIcon from "@lucide/astro/icons/brush";
import HammerIcon from "@lucide/astro/icons/hammer";

import { m } from "@/paraglide/messages";
import { Image } from "astro:assets";
import Link from "./ui/Link.astro";
import { getLocale } from "@/paraglide/runtime";

const items = [
  { label: m.header_about(), href: "/", Icon: InfoIcon },
  { label: m.header_contact(), href: "/contact", Icon: MailQuestionMarkIcon },
  { label: m.header_blog(), href: "/blog", Icon: RSSIcon },
  { label: m.header_gallery(), href: "/gallery", Icon: BrushIcon },
  { label: m.header_projects(), href: "/projects", Icon: HammerIcon },
];

const socials = [
  { label: "GitHub", href: "https://github.com/sprucepad", Icon: GitHubIcon },
  {
    label: "YouTube",
    href: "https://youtube.com/@sprucepad",
    Icon: YouTubeIcon,
  },
  {
    label: "Reddit",
    href: "https://reddit.com/user/sprucepad",
    Icon: RedditIcon,
  },
  {
    label: "Bluesky",
    href: "https://bsky.app/profile/sprucepad.net",
    Icon: BskyIcon,
  },
  { label: "itch.io", href: "https://sprucepad.itch.io/", Icon: ItchIoIcon },
];

const locale = getLocale();
---

<header
  id="header"
  transition:name="header"
  class="group/header fixed inset-0 isolate z-50 h-16 transform p-2 transition-transform before:absolute before:inset-0 before:-z-50 before:bg-background/75 before:backdrop-blur-lg data-hidden:-translate-y-full"
>
  <nav class="flex items-center gap-4">
    <button name="toggle" type="button" class="sm:hidden" aria-hidden="true">
      <MenuIcon class="block group-data-open/header:hidden" />
      <XIcon class="hidden group-data-open/header:block" />
    </button>

    <Link href="/" class="flex items-center font-pixel text-2xl font-black">
      <Image
        src={pfp}
        width={48}
        height={48}
        format="png"
        class="pixel-art"
        alt=""
      />
      <span class="hidden max-sm:block md:block">sprucepad</span>
    </Link>
    <ul
      class="fixed top-16 left-0 flex h-full -translate-x-full transform flex-col bg-background/75 p-2 backdrop-blur-lg transition-transform group-data-open/header:translate-x-0 sm:static sm:translate-x-0 sm:flex-row sm:bg-transparent sm:p-0"
      transition:animate="slide"
    >
      {items.map((item) => {
        const pathname = Astro.url.pathname.replace("/" + locale, "");

        return (
          <li>
            <Link
              href={item.href}
              class="flex gap-1 rounded-lg p-2 hover:underline data-selected:bg-accent data-selected:text-accent-foreground"
              transition:animate="fade"
              data-selected={
                (item.href === "/"
                  ? pathname === item.href
                  : pathname.startsWith(item.href)) || undefined
              }
            >
              <item.Icon /> {item.label}
            </Link>
          </li>
        );
      })}
    </ul>

    <ul class="absolute right-4 flex gap-2">
      <li class="group/social relative">
        <Link href="https://buymeacoffee.com/sprucepad">
          <BMCIcon width={24} height={24} />
        </Link>
        <span class="pointer-events-none absolute top-8 right-0 w-max rounded-lg bg-secondary p-2 text-sm text-secondary-foreground opacity-0 transition-opacity group-hover/social:opacity-100">
          Buy Me a Coffee!
        </span>
      </li>

      <li class="group/socials more-socials">
        <button class="group/social relative cursor-pointer" aria-hidden="true">
          <HeartPlusIcon />
        </button>

        <ul class="fixed top-12 right-0 flex translate-x-full transform flex-col gap-2 p-4 transition-transform group-hover/socials:translate-x-0 group-data-open/socials:translate-x-0">
          {socials.map((social) => (
            <li class="group/social relative">
              <Link href={social.href}>
                <social.Icon width={24} height={24} />
              </Link>
              <span class="pointer-events-none absolute -top-1/4 right-[calc(100%+0.25rem)] w-max rounded-lg bg-secondary p-2 text-sm text-secondary-foreground opacity-0 transition-opacity group-hover/social:opacity-100">
                {social.label}
              </span>
            </li>
          ))}
        </ul>
      </li>
    </ul>
  </nav>

  <script>
    let controller: AbortController | undefined;

    document.addEventListener("astro:page-load", () => {
      controller?.abort();
      controller = new AbortController();
      const signal = controller.signal;

      const $header = document.getElementById("header");
      const $toggle = $header?.querySelector("[name=toggle]");
      const $moreSocials = $header?.querySelector(".more-socials");

      $toggle?.addEventListener("click", () => {
        $header?.toggleAttribute("data-open");
      });

      $moreSocials?.addEventListener("click", () => {
        $moreSocials.toggleAttribute("data-open");
      });

      let prevScroll = window.scrollY;
      window.addEventListener(
        "scroll",
        () => {
          if (document.activeViewTransition) return;

          if (window.scrollY - prevScroll >= 0)
            $header?.setAttribute("data-hidden", "");
          else $header?.removeAttribute("data-hidden");

          prevScroll = window.scrollY;
        },
        { signal },
      );
    });
  </script>
</header>
