---
import { cn } from "cn";
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale } from "@/paraglide/runtime";

type Props = HTMLAttributes<"a">;

const { rel, target, href, ...rest } = Astro.props;

const aTarget =
  target ?? (href?.toString().startsWith("https://") ? "_blank" : undefined);
const aRel =
  !aTarget && aTarget !== "_self" ? cn("noreferrer noopener", rel) : rel;
const aHref =
  !aTarget || aTarget === "_self"
    ? getRelativeLocaleUrl(
        getLocale(),
        href instanceof URL ? href.pathname : (href ?? undefined),
      )
    : href;
---

<a {...rest} href={aHref} target={aTarget} rel={aRel}>
  <slot />
</a>
