---
export interface ThemeDetail {
  mode?: "off" | "uwu";
  theme?: string;

  colors?: {
    background?: string;
    foreground?: string;
    accent?: string;
    accentForeground?: string;
    secondary?: string;
    secondaryForeground?: string;
  };
}
---

<script>
  import type { ThemeDetail } from "./Themes.astro";

  window.addEventListener("themechange", (event) => {
    const e = event as CustomEvent<ThemeDetail>;
    setTheme(e.detail.theme, e.detail.mode);
  });

  setTheme(
    !document.documentElement.dataset.theme?.includes(":")
      ? localStorage.getItem("theme")
      : null,
    parseUwu() ?? localStorage.getItem("mode"),
  );

  function setTheme(theme?: string | null, mode?: string | null) {
    if (theme) {
      document.documentElement.dataset.theme = theme;

      // post-specific themes will always include `:` for the theme ID
      // we don't want to save post-specific themes
      if (!theme.includes(":")) localStorage.setItem("theme", theme);
    }
    if (mode) {
      document.documentElement.dataset.mode = mode;
      localStorage.setItem("mode", mode);
    }
  }

  function parseUwu() {
    const param = new URLSearchParams(location.search).get("uwu");
    if (param == null) return null;

    if (param === "" || param === "uwu") return "uwu";
    return "off";
  }
</script>
