<script>
  import type { ThemeDetail } from "@/lib/types";

  window.addEventListener("themechange", (event) => {
    const e = event as CustomEvent<ThemeDetail>;
    setTheme({
      id: e.detail.id,
      scheme: e.detail.scheme,
      mode: e.detail.mode,
    });
  });

  function updateDefaultTheme() {
    setTheme({
      scheme: !document.documentElement.dataset.theme?.includes(":")
        ? localStorage.getItem("scheme")
        : null,
      mode: parseUwu() ?? localStorage.getItem("mode"),
    });
  }

  updateDefaultTheme();
  document.addEventListener("astro:page-load", updateDefaultTheme);

  function setTheme(opts: {
    scheme?: string | null;
    id?: string | null;
    mode?: string | null;
  }) {
    if (opts.scheme) {
      document.documentElement.dataset.theme =
        opts.scheme + (opts.id ? `:${opts.id}` : "");
      localStorage.setItem("scheme", opts.scheme);
    }
    if (opts.mode) {
      document.documentElement.dataset.mode = opts.mode;
      localStorage.setItem("mode", opts.mode);
    }
  }

  function parseUwu() {
    const param = new URLSearchParams(location.search).get("uwu");
    if (param == null) return null;

    if (param === "" || param === "uwu") return "uwu";
    return "off";
  }
</script>
