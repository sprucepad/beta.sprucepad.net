---
import type { HTMLAttributes } from "astro/types";
import { cn } from "cn";

type Props = HTMLAttributes<"article">;

const { class: className, ...rest } = Astro.props;
---

<article
  class={cn(
    "prose mx-auto prose-headings:font-pixel dark:prose-invert",
    className,
  )}
  {...rest}
>
  <slot />
</article>
