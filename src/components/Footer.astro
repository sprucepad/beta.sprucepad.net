---
import { getLocale } from "@/paraglide/runtime";
import MoonIcon from "@lucide/astro/icons/moon";
import SunIcon from "@lucide/astro/icons/sun";

const locale = getLocale();
---

<footer
  transition:persist="footer"
  transition:animate="slide"
  class="flex flex-wrap justify-around gap-4 p-4 opacity-50"
>
  <p>&copy; 2025-{new Date().getFullYear()} sprucepad.</p>

  <button
    id="theme-select"
    class="custom:hidden cursor-pointer"
    aria-label="Switch Theme"
  >
    <MoonIcon class="dark:hidden" />
    <SunIcon class="hidden dark:block" />
  </button>

  <select id="language">
    <option value="pt" selected={locale === "en"}>
      Português
    </option>
    <option value="en" selected={locale === "en"}>
      English
    </option>
  </select>
</footer>

<script>
  import { navigate } from "astro:transitions/client";
  import type { ThemeDetail } from "./Themes.astro";

  const $language = document.getElementById(
    "language",
  ) as HTMLSelectElement | null;
  let currentLocale = $language?.value ?? "pt";
  $language?.addEventListener("change", () => {
    const unlocalizedPathname = location.pathname.replace(
      "/" + currentLocale,
      "",
    );
    currentLocale = $language?.value;
    navigate(`/${currentLocale}${unlocalizedPathname}`);
  });

  const $themeSelect = document.getElementById("theme-select");
  $themeSelect?.addEventListener("click", () => {
    window.dispatchEvent(
      new CustomEvent("themechange", {
        detail: {
          scheme: (
            document.documentElement.dataset.theme ?? "light"
          ).startsWith("light")
            ? "dark"
            : "light",
        } satisfies ThemeDetail,
      }),
    );
  });
</script>
